{
  "name": "Client",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Owning tenant id (Tenant record). THE tenant isolation key \u2014 RLS requires an exact match with the user's tenant stamp. A tenant's own client records (e.g. an accounting firm's own customers) are scoped inside that tenant; different tenants never see each other's client records."
    },
    "name": {
      "type": "string",
      "description": "Client / end-customer name"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Alternate names or nicknames for this client as they appear in transcripts and questions"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active",
      "description": "Whether this client is active"
    },
    "notes": {
      "type": "string",
      "description": "Optional freeform notes"
    },
    "is_eval_fixture": {
      "type": "boolean",
      "description": "True only for records created by the RAG evaluation harness. Never set on real data."
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        }
      ]
    }
  }
}