{
  "name": "AppConfig",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Config key. A single row with key 'chat' holds the chatbot engine settings."
    },
    "chat_engine": {
      "type": "string",
      "enum": [
        "legacy",
        "rag"
      ],
      "default": "legacy",
      "description": "Which chatbot backend the Chat page uses. 'legacy' = askKnowledgeBase (production default). 'rag' = askKnowledgeBaseV2."
    },
    "rag_rollout_pct": {
      "type": "number",
      "default": 0,
      "description": "0-100. While chat_engine is 'legacy', this fraction of users (by stable hash of user id) is routed to the RAG engine for canary testing."
    },
    "retrieval_mode": {
      "type": "string",
      "enum": [
        "auto",
        "lexical",
        "semantic"
      ],
      "default": "auto",
      "description": "How askKnowledgeBaseV2 retrieves. 'auto' (default): use semantic embeddings when the query embed() call succeeds, otherwise fall back to lexical/keyword ranking automatically. 'lexical': never call the embeddings provider. 'semantic': require embeddings and error loudly if unavailable. Embeddings are an optional enhancement — no deployment needs EMBEDDINGS_API_KEY to use the knowledge base."
    },
    "require_verification_for_retrieval": {
      "type": "boolean",
      "default": false,
      "description": "Phase 3 governance flag (row key:'system'). When true, askKnowledgeBaseV2 retrieves only KnowledgeChunks whose source verification_status is 'verified'. Default false so legacy / unverified knowledge keeps answering. 'rejected' sources are always excluded regardless of this flag."
    },
    "require_ingestion_review": {
      "type": "boolean",
      "default": false,
      "description": "Phase 3 governance flag (row key:'system'). When true, chunks whose source ingestion_quality is 'needs_review' are excluded from retrieval. Default false; legacy sources have no value and are treated as 'ok'."
    },
    "governance_ranking_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Phase 3 governance flag (row key:'system'). When true (default), rankChunks applies a small additive source-authority boost and freshness penalty. Non-destructive — missing metadata is neutral. Kept as a kill-switch if eval recall regresses."
    },
    "answer_logging_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Phase 3 observability flag (row key:'system'). When true, askKnowledgeBaseV2 writes one AnswerLog row per question (knowledge-quality analytics — no asking-user id is stored). Default false: logging raw employee questions is an explicit admin opt-in."
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": true,
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
