{
  "name": "AppConfig",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Config key. A single row with key 'chat' holds the chatbot engine settings."
    },
    "chat_engine": {
      "type": "string",
      "enum": [
        "legacy",
        "rag"
      ],
      "default": "legacy",
      "description": "Which chatbot backend the Chat page uses. 'legacy' = askKnowledgeBase (production default). 'rag' = askKnowledgeBaseV2."
    },
    "rag_rollout_pct": {
      "type": "number",
      "default": 0,
      "description": "0-100. While chat_engine is 'legacy', this fraction of users (by stable hash of user id) is routed to the RAG engine for canary testing."
    },
    "retrieval_mode": {
      "type": "string",
      "enum": [
        "auto",
        "lexical",
        "semantic"
      ],
      "default": "auto",
      "description": "How askKnowledgeBaseV2 retrieves. 'auto' (default): use semantic embeddings when the query embed() call succeeds, otherwise fall back to lexical/keyword ranking automatically. 'lexical': never call the embeddings provider. 'semantic': require embeddings and error loudly if unavailable. Embeddings are an optional enhancement — no deployment needs EMBEDDINGS_API_KEY to use the knowledge base."
    },
    "require_verification_for_retrieval": {
      "type": "boolean",
      "default": false,
      "description": "Phase 3 governance flag (row key:'system'). When true, askKnowledgeBaseV2 retrieves only KnowledgeChunks whose source verification_status is 'verified'. Default false so legacy / unverified knowledge keeps answering. 'rejected' sources are always excluded regardless of this flag."
    },
    "require_ingestion_review": {
      "type": "boolean",
      "default": false,
      "description": "Phase 3 governance flag (row key:'system'). When true, chunks whose source ingestion_quality is 'needs_review' are excluded from retrieval. Default false; legacy sources have no value and are treated as 'ok'."
    },
    "governance_ranking_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Phase 3 governance flag (row key:'system'). When true (default), rankChunks applies a small additive source-authority boost and freshness penalty. Non-destructive — missing metadata is neutral. Kept as a kill-switch if eval recall regresses."
    },
    "answer_logging_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Phase 3 observability flag (row key:'system'). When true, askKnowledgeBaseV2 writes one AnswerLog row per question (knowledge-quality analytics — no asking-user id is stored). Default false: logging raw employee questions is an explicit admin opt-in."
    },
    "operational_answer_mode": {
      "type": "boolean",
      "default": false,
      "description": "Phase 4 flag (row key:'system'). When true AND the question intent is operational, askKnowledgeBaseV2 runs a structured operational answer (direct answer / steps / prerequisites / approvals / exceptions / prohibited actions / verification checkpoints / escalation / watch-outs / systems / expected result) with a HIGH/PARTIAL/INSUFFICIENT grounding status, INSTEAD OF the prose answer. Default false: prose behavior is byte-identical to today. On an operational-generation failure the request falls back to the prose path."
    },
    "knowledge_gaps_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Phase 5 master flag (row key:'system'). Enables the answer-feedback UI, submitKnowledgeFeedback / logKnowledgeGap writes, and the admin KnowledgeGapManager. Off => all Phase 5 gap endpoints no-op and no feedback UI renders."
    },
    "clarifications_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Phase 5 flag (row key:'system'). Enables 'I still need help', ClarificationRequest/ClarificationMessage threads, replyToClarification / respondToClarification, and the /my-questions view. Independent of knowledge_gaps_enabled."
    },
    "auto_gap_from_answer_status": {
      "type": "boolean",
      "default": false,
      "description": "Phase 5 flag (row key:'system'). When true AND knowledge_gaps_enabled is also true, askKnowledgeBaseV2 best-effort accrues gap evidence from operational PARTIAL (with missing_facets) and operational INSUFFICIENT (with ranked.length > 0). Never fires for zero-candidate INSUFFICIENT. The write is swallowed on error and never affects the answer or its latency."
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": true,
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
