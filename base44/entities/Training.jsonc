{
  "name": "Training",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Owning tenant id (Tenant record). THE tenant isolation key \u2014 RLS requires an exact match with the user's tenant stamp. Creation goes through the createKnowledgeSource backend function (version forking inherits it via the lifecycle engine), which stamps the VERIFIED tenant server-side and never trusts this field from a request payload. tenant_id is immutable after create."
    },
    "title": {
      "type": "string",
      "description": "Title of the training session"
    },
    "category": {
      "type": "string",
      "description": "Legacy category field"
    },
    "topic_category": {
      "type": "string",
      "enum": [
        "Bookkeeping",
        "Payroll",
        "Tax Prep",
        "Reconciliation",
        "Reporting",
        "Cash Flow",
        "Entity Management",
        "Client Communication",
        "Operations",
        "Compliance",
        "Troubleshooting",
        "Other"
      ],
      "description": "Topic classification"
    },
    "client_segment": {
      "type": "string",
      "enum": [
        "Small Business",
        "High-Net-Worth Household",
        "Both",
        "Internal Only"
      ],
      "description": "Who this training applies to"
    },
    "video_url": {
      "type": "string",
      "description": "Link to the Google Meet recording"
    },
    "transcript": {
      "type": "string",
      "description": "URL to the uploaded transcript file"
    },
    "summary": {
      "type": "string",
      "description": "AI-generated summary of the training"
    },
    "key_takeaways": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Key lessons from the training"
    },
    "sop_steps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Step-by-step standard operating procedure"
    },
    "decision_rules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "If/then decision logic extracted from the training"
    },
    "common_mistakes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Common errors, risks, and watchouts"
    },
    "required_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Information, documents, or access needed"
    },
    "final_output": {
      "type": "string",
      "description": "What the workflow produces"
    },
    "software_systems": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Software and tools mentioned"
    },
    "app_feature_opportunities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "feature_name": {
            "type": "string"
          },
          "problem_solved": {
            "type": "string"
          },
          "user_type": {
            "type": "string"
          },
          "required_inputs": {
            "type": "string"
          },
          "output": {
            "type": "string"
          },
          "facing": {
            "type": "string",
            "enum": [
              "Internal",
              "Client-Facing",
              "Both"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "High",
              "Medium",
              "Low"
            ]
          },
          "internal_need_score": {
            "type": "number",
            "description": "1-5: how clearly the transcript shows this solves a real workflow problem"
          },
          "market_demand_score": {
            "type": "number",
            "description": "1-5: alignment with financial services/fintech/AI trends, refreshed by external market signals"
          },
          "business_value_score": {
            "type": "number",
            "description": "1-5: usefulness for internal team, clients, or both"
          },
          "implementation_complexity_score": {
            "type": "number",
            "description": "1-5: 1 easy, 5 complex"
          },
          "priority_reason": {
            "type": "string",
            "description": "Plain-English explanation of the assigned priority"
          },
          "market_demand_summary": {
            "type": "string",
            "description": "Whether market demand is increasing, stable, or low, with trend context"
          },
          "market_signal_sources": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Trends, news themes, or industry signals that informed the market demand score"
          },
          "last_market_check_date": {
            "type": "string",
            "format": "date-time",
            "description": "When the market demand was last refreshed"
          }
        }
      },
      "description": "Potential features for the financial concierge AI app"
    },
    "ai_knowledge_entry": {
      "type": "string",
      "description": "Clean knowledge entry for the AI assistant"
    },
    "duration_minutes": {
      "type": "number",
      "description": "Duration estimate in minutes"
    },
    "drive_file_id": {
      "type": "string",
      "description": "Google Drive file ID"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional tags"
    },
    "presenter": {
      "type": "string",
      "description": "Name of the presenter"
    },
    "status": {
      "type": "string",
      "enum": [
        "processing",
        "ready",
        "error"
      ],
      "default": "processing",
      "description": "Processing status"
    },
    "knowledge_scope": {
      "type": "string",
      "enum": [
        "unclassified",
        "general",
        "client-specific"
      ],
      "default": "unclassified",
      "description": "RAG retrieval scope. 'unclassified' (default for legacy and new records) is never retrieved until a human deliberately classifies it as 'general' (firm-wide) or 'client-specific'."
    },
    "client_id": {
      "type": "string",
      "description": "Set only when knowledge_scope is 'client-specific'. References a Client record; retrieval requires an exact match with the active client context."
    },
    "client_name": {
      "type": "string",
      "description": "Denormalized Client name, for display and filtering."
    },
    "is_eval_fixture": {
      "type": "boolean",
      "description": "True only for records created by the RAG evaluation harness. Never set on real data."
    },
    "source_type": {
      "type": "string",
      "enum": [
        "recording",
        "transcript",
        "sop",
        "process_doc",
        "policy",
        "checklist",
        "reference",
        "legacy_unspecified",
        "other"
      ],
      "description": "What kind of knowledge source this is. Not defaulted for legacy records \u2014 set from the Add Knowledge picker, or reliably inferred at ingestion. Never manufactured as 'recording' for records that lack real source metadata."
    },
    "source_format": {
      "type": "string",
      "enum": [
        "gdoc",
        "docx",
        "txt",
        "md",
        "vtt",
        "srt",
        "pasted",
        "url",
        "other"
      ],
      "description": "The format the source was ingested from."
    },
    "source_filename": {
      "type": "string",
      "description": "Original filename of the uploaded source, if any."
    },
    "source_url": {
      "type": "string",
      "description": "Canonical URL of the source (Google Doc, SharePoint, etc.), distinct from the extracted-transcript file URL."
    },
    "department": {
      "type": "string",
      "description": "Owning department, when known at the source level. Governance ownership lives on the linked OperationalProcess."
    },
    "operational_process_id": {
      "type": "string",
      "description": "Optional link to an OperationalProcess. Governance (owner, SME, review cadence, freshness, criticality) is authoritative on that process, not duplicated here."
    },
    "source_authority": {
      "type": "string",
      "enum": [
        "policy",
        "approved_sop",
        "approved_procedure",
        "training",
        "reference",
        "notes"
      ],
      "description": "Authority level of this source. Used later as a retrieval rerank signal; never used to silently hide a genuine contradiction."
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "unverified",
        "verified",
        "rejected"
      ],
      "default": "unverified",
      "description": "Human verification state. Retrieval does not gate on this until a later phase, and only when the require_verification_for_retrieval flag is on."
    },
    "verified_by": {
      "type": "string",
      "description": "Base44 user ID of the verifier (stable ID only, never a name). Resolve the display name separately from user data."
    },
    "verified_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this source was verified."
    },
    "version_number": {
      "type": "number",
      "default": 1,
      "description": "Version of this logical knowledge source. Missing = treated as 1."
    },
    "supersedes_source_id": {
      "type": "string",
      "description": "The prior Training record this version replaces, if any."
    },
    "is_active_version": {
      "type": "boolean",
      "default": true,
      "description": "Whether this is the currently active version. Missing = treated as active. Only active versions are retrieved (enforced in a later phase)."
    },
    "effective_from": {
      "type": "string",
      "format": "date-time",
      "description": "Date this knowledge becomes effective. Missing = always effective."
    },
    "effective_until": {
      "type": "string",
      "format": "date-time",
      "description": "Date this knowledge stops being effective. Missing = no expiry."
    },
    "ingestion_quality": {
      "type": "string",
      "enum": [
        "ok",
        "needs_review"
      ],
      "description": "Set by analyzeTraining. 'needs_review' means extraction succeeded on real text but looks thin and should be reviewed before being trusted as operational knowledge. Missing = treated as 'ok'. Phase 3 adds a flag-gated retrieval gate on this (require_ingestion_review, default off); with the flag off it does not affect retrieval."
    },
    "is_archived": {
      "type": "boolean",
      "description": "Phase 3 field, populated by the Phase 6 review lifecycle. When true, this source's KnowledgeChunks are excluded from retrieval and embedKnowledge stops building chunks for it. Missing = treated as not archived. Phase 3 only reads this; nothing in Phase 3 sets it."
    },
    "archived_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this source was archived. Audit only."
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Extracted by analyzeTraining (Phase 1): situations where the normal procedure changes. Additive; empty when unsupported."
    },
    "roles_involved": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Extracted by analyzeTraining (Phase 1): job roles or titles that participate. Additive."
    },
    "approvers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Extracted by analyzeTraining (Phase 1): roles or titles who must approve or sign off, and what they approve. Additive."
    },
    "escalation_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Extracted by analyzeTraining (Phase 1): 'if X then escalate to Y' statements. Additive."
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Extracted by analyzeTraining (Phase 1): conditions or steps required before the process can start. Additive."
    },
    "deadlines": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Extracted by analyzeTraining (Phase 1): timing constraints and due dates. Additive."
    },
    "verification_checkpoints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Extracted by analyzeTraining (Phase 1): checks that confirm a step was done correctly. Additive."
    },
    "prohibited_actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Extracted by analyzeTraining (Phase 1): things that must not be done. Additive."
    },
    "process_name": {
      "type": "string",
      "description": "Extracted by analyzeTraining (Phase 1): the canonical name of the operational process this source documents, when stated. Additive."
    },
    "root_source_id": {
      "type": "string",
      "description": "Phase 6. Stable lineage handle shared by every version of one logical knowledge source. Missing = treated as self (this row's id), i.e. version 1. Set by the lifecycle engine binding when a version is forked."
    },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "draft",
        "in_review",
        "changes_requested",
        "verified",
        "active",
        "archived",
        "rejected"
      ],
      "description": "Phase 6. Denormalized from THIS row's own fields only (is_archived, verification_status, is_active_version, review_outcome, review_requested_at) by deriveLifecycleState. Written in the same write as those fields by the lifecycle engine; reconcile asserts it matches the derivation. 'superseded' / 'has open draft' / 'latest version' are lineage-computed VIEW labels, never stored here. Missing = derive on read."
    },
    "review_requested_at": {
      "type": "string",
      "format": "date-time",
      "description": "Phase 6. Set when a draft is submitted for verification. Drives the 'in_review' derived state. Cleared/reset by verify / reject / create_version / restore."
    },
    "index_status": {
      "type": "string",
      "enum": [
        "pending",
        "indexing",
        "indexed",
        "failed",
        "skipped"
      ],
      "description": "Phase 6. Human/ops rollup of the derived-index state. NEVER read by retrieval \u2014 retrieval gates only on KnowledgeChunk.index_stale. Missing = lazily treated 'indexed' if the source is classified with >=1 chunk, else 'skipped'/'pending'."
    },
    "index_error": {
      "type": "string",
      "description": "Phase 6. Last re-index failure reason, run through redact(), capped ~800 chars. Diagnostics only."
    },
    "indexed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Phase 6. When this version's derived index last reached a verified-success state."
    },
    "indexed_content_hash": {
      "type": "string",
      "description": "Phase 6. Fingerprint of the concatenated draft-chunk inputs at last verified success. A match proves CONTENT IDENTITY ONLY \u2014 it is necessary but NOT sufficient for an index no-op; the desired chunk set must also be complete and assertResourceMatchesIndex must be clean."
    },
    "indexed_version_number": {
      "type": "number",
      "description": "Phase 6. Which version_number the current KnowledgeChunks reflect. Activation precondition compares this to the draft's version_number."
    },
    "lifecycle_seq": {
      "type": "number",
      "default": 0,
      "description": "Phase 6. Optimistic-concurrency counter. Every governed lifecycle mutation reads it, checks it against the operation's expected value, then increments it in the same write. Guards double-click, stale-browser, and concurrent operations."
    },
    "last_reviewed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Phase 6. Source-level review timestamp (distinct from the linked OperationalProcess's own review timestamp). Set by the confirm_current / updated review actions."
    },
    "next_review_due_at": {
      "type": "string",
      "format": "date-time",
      "description": "Phase 6. Computed = last_reviewed_at + resolved interval. Missing = source_freshness_status 'unknown'. Consumed only by the admin panel and Phase 7 \u2014 never by retrieval or ranking."
    },
    "reviewed_by": {
      "type": "string",
      "description": "Phase 6. Base44 user ID of the last source-level reviewer (stable ID only)."
    },
    "review_outcome": {
      "type": "string",
      "enum": [
        "confirmed_current",
        "updated",
        "changes_requested",
        "archived"
      ],
      "description": "Phase 6. Result of the last review action. 'changes_requested' also drives the derived lifecycle_state; verify / submit / reject / restore reset it so deriveLifecycleState cannot return the prior state."
    },
    "source_review_interval_days": {
      "type": "number",
      "minimum": 1,
      "description": "Phase 6. Per-source review-cadence override. Missing = inherit the linked OperationalProcess.review_interval_days; both missing = no cadence (freshness 'unknown')."
    },
    "changes_requested_note": {
      "type": "string",
      "description": "Phase 6. Reviewer feedback attached by request_changes, capped ~2000 chars. Admin-only, NEVER retrieved. Cleared by verify / submit / un_reject / restore."
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}