{
  "name": "Training",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Title of the training session"
    },
    "category": {
      "type": "string",
      "description": "Legacy category field"
    },
    "topic_category": {
      "type": "string",
      "enum": [
        "Bookkeeping",
        "Payroll",
        "Tax Prep",
        "Reconciliation",
        "Reporting",
        "Cash Flow",
        "Entity Management",
        "Client Communication",
        "Operations",
        "Compliance",
        "Troubleshooting",
        "Other"
      ],
      "description": "Topic classification"
    },
    "client_segment": {
      "type": "string",
      "enum": [
        "Small Business",
        "High-Net-Worth Household",
        "Both",
        "Internal Only"
      ],
      "description": "Who this training applies to"
    },
    "video_url": {
      "type": "string",
      "description": "Link to the Google Meet recording"
    },
    "transcript": {
      "type": "string",
      "description": "URL to the uploaded transcript file"
    },
    "summary": {
      "type": "string",
      "description": "AI-generated summary of the training"
    },
    "key_takeaways": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Key lessons from the training"
    },
    "sop_steps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Step-by-step standard operating procedure"
    },
    "decision_rules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "If/then decision logic extracted from the training"
    },
    "common_mistakes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Common errors, risks, and watchouts"
    },
    "required_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Information, documents, or access needed"
    },
    "final_output": {
      "type": "string",
      "description": "What the workflow produces"
    },
    "software_systems": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Software and tools mentioned"
    },
    "app_feature_opportunities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "feature_name": {
            "type": "string"
          },
          "problem_solved": {
            "type": "string"
          },
          "user_type": {
            "type": "string"
          },
          "required_inputs": {
            "type": "string"
          },
          "output": {
            "type": "string"
          },
          "facing": {
            "type": "string",
            "enum": [
              "Internal",
              "Client-Facing",
              "Both"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "High",
              "Medium",
              "Low"
            ]
          },
          "internal_need_score": {
            "type": "number",
            "description": "1-5: how clearly the transcript shows this solves a real workflow problem"
          },
          "market_demand_score": {
            "type": "number",
            "description": "1-5: alignment with financial services/fintech/AI trends, refreshed by external market signals"
          },
          "business_value_score": {
            "type": "number",
            "description": "1-5: usefulness for internal team, clients, or both"
          },
          "implementation_complexity_score": {
            "type": "number",
            "description": "1-5: 1 easy, 5 complex"
          },
          "priority_reason": {
            "type": "string",
            "description": "Plain-English explanation of the assigned priority"
          },
          "market_demand_summary": {
            "type": "string",
            "description": "Whether market demand is increasing, stable, or low, with trend context"
          },
          "market_signal_sources": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Trends, news themes, or industry signals that informed the market demand score"
          },
          "last_market_check_date": {
            "type": "string",
            "format": "date-time",
            "description": "When the market demand was last refreshed"
          }
        }
      },
      "description": "Potential features for the financial concierge AI app"
    },
    "ai_knowledge_entry": {
      "type": "string",
      "description": "Clean knowledge entry for the AI assistant"
    },
    "duration_minutes": {
      "type": "number",
      "description": "Duration estimate in minutes"
    },
    "drive_file_id": {
      "type": "string",
      "description": "Google Drive file ID"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional tags"
    },
    "presenter": {
      "type": "string",
      "description": "Name of the presenter"
    },
    "status": {
      "type": "string",
      "enum": [
        "processing",
        "ready",
        "error"
      ],
      "default": "processing",
      "description": "Processing status"
    },
    "knowledge_scope": {
      "type": "string",
      "enum": [
        "unclassified",
        "general",
        "client-specific"
      ],
      "default": "unclassified",
      "description": "RAG retrieval scope. 'unclassified' (default for legacy and new records) is never retrieved until a human deliberately classifies it as 'general' (firm-wide) or 'client-specific'."
    },
    "client_id": {
      "type": "string",
      "description": "Set only when knowledge_scope is 'client-specific'. References a Client record; retrieval requires an exact match with the active client context."
    },
    "client_name": {
      "type": "string",
      "description": "Denormalized Client name, for display and filtering."
    },
    "is_eval_fixture": {
      "type": "boolean",
      "description": "True only for records created by the RAG evaluation harness. Never set on real data."
    },
    "source_type": {
      "type": "string",
      "enum": [
        "recording",
        "transcript",
        "sop",
        "process_doc",
        "policy",
        "checklist",
        "reference",
        "legacy_unspecified",
        "other"
      ],
      "description": "What kind of knowledge source this is. Not defaulted for legacy records — set from the Add Knowledge picker, or reliably inferred at ingestion. Never manufactured as 'recording' for records that lack real source metadata."
    },
    "source_format": {
      "type": "string",
      "enum": [
        "gdoc",
        "docx",
        "txt",
        "md",
        "vtt",
        "srt",
        "pasted",
        "url",
        "other"
      ],
      "description": "The format the source was ingested from."
    },
    "source_filename": {
      "type": "string",
      "description": "Original filename of the uploaded source, if any."
    },
    "source_url": {
      "type": "string",
      "description": "Canonical URL of the source (Google Doc, SharePoint, etc.), distinct from the extracted-transcript file URL."
    },
    "department": {
      "type": "string",
      "description": "Owning department, when known at the source level. Governance ownership lives on the linked OperationalProcess."
    },
    "operational_process_id": {
      "type": "string",
      "description": "Optional link to an OperationalProcess. Governance (owner, SME, review cadence, freshness, criticality) is authoritative on that process, not duplicated here."
    },
    "source_authority": {
      "type": "string",
      "enum": [
        "policy",
        "approved_sop",
        "approved_procedure",
        "training",
        "reference",
        "notes"
      ],
      "description": "Authority level of this source. Used later as a retrieval rerank signal; never used to silently hide a genuine contradiction."
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "unverified",
        "verified",
        "rejected"
      ],
      "default": "unverified",
      "description": "Human verification state. Retrieval does not gate on this until a later phase, and only when the require_verification_for_retrieval flag is on."
    },
    "verified_by": {
      "type": "string",
      "description": "Base44 user ID of the verifier (stable ID only, never a name). Resolve the display name separately from user data."
    },
    "verified_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this source was verified."
    },
    "version_number": {
      "type": "number",
      "default": 1,
      "description": "Version of this logical knowledge source. Missing = treated as 1."
    },
    "supersedes_source_id": {
      "type": "string",
      "description": "The prior Training record this version replaces, if any."
    },
    "is_active_version": {
      "type": "boolean",
      "default": true,
      "description": "Whether this is the currently active version. Missing = treated as active. Only active versions are retrieved (enforced in a later phase)."
    },
    "effective_from": {
      "type": "string",
      "format": "date-time",
      "description": "Date this knowledge becomes effective. Missing = always effective."
    },
    "effective_until": {
      "type": "string",
      "format": "date-time",
      "description": "Date this knowledge stops being effective. Missing = no expiry."
    },
    "ingestion_quality": {
      "type": "string",
      "enum": [
        "ok",
        "needs_review"
      ],
      "description": "Set by analyzeTraining. 'needs_review' means extraction succeeded on real text but looks thin and should be reviewed before being trusted as operational knowledge. Missing = treated as 'ok'. A later phase adds a flag-gated retrieval/indexing gate on this; it does not affect retrieval in Phase 1."
    }
  },
  "required": [
    "title"
  ]
}