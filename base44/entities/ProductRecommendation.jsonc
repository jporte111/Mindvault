{
  "name": "ProductRecommendation",
  "type": "object",
  "properties": {
    "product_name_idea": {
      "type": "string",
      "description": "Proposed product name"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional freeform description (up to 1000 characters)"
    },
    "positioning_statement": {
      "type": "string",
      "description": "One-sentence positioning statement"
    },
    "target_users": {
      "type": "string",
      "description": "Who the product is for"
    },
    "main_problem_solved": {
      "type": "string",
      "description": "The core problem this product solves"
    },
    "core_modules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Main modules or components of the product"
    },
    "unique_business_advantage": {
      "type": "string",
      "description": "Why this is unique to our business"
    },
    "why_hard_to_copy": {
      "type": "string",
      "description": "Why competitors would struggle to copy this"
    },
    "competitive_positioning": {
      "type": "string",
      "description": "How it competes against broad platforms without copying them"
    },
    "first_version_mvp": {
      "type": "string",
      "description": "What the first version should include"
    },
    "future_version_roadmap": {
      "type": "string",
      "description": "What future versions could add"
    },
    "risks_or_weaknesses": {
      "type": "string",
      "description": "Risks and weaknesses to watch"
    },
    "data_needed_to_improve_confidence": {
      "type": "string",
      "description": "What additional data would improve confidence"
    },
    "additional_training_topics_needed": {
      "type": "string",
      "description": "What training topics would improve the recommendation"
    },
    "confidence_level": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High"
      ],
      "description": "Confidence level based on transcript count"
    },
    "confidence_reason": {
      "type": "string",
      "description": "Why this confidence level was assigned"
    },
    "related_product_clusters": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Cluster names this recommendation builds on"
    },
    "related_training_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of key trainings contributing to this recommendation"
    },
    "last_updated_date": {
      "type": "string",
      "format": "date-time",
      "description": "When this recommendation was last updated"
    }
  },
  "required": [
    "product_name_idea"
  ]
}